#!/bin/bash
set -e

# Backend
if git diff --cached --name-only | grep -q "^src/backend/"; then
  echo "Running backend checks..."
  cd src/backend
  ruff check .
  ruff format --check .
fi

# Frontend
if git diff --cached --name-only | grep -q "^src/frontend/"; then
  echo "Running frontend checks..."
  cd src/frontend
  npm run lint
  npm run typecheck
fi