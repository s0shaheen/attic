#!/bin/bash
set -e

# Run tests before push
if git diff --name-only origin/main...HEAD | grep -q "^src/backend/"; then
  echo "Running backend tests..."
  cd src/backend
  pytest tests/ -x --tb=short
fi

if git diff --name-only origin/main...HEAD | grep -q "^src/frontend/"; then
  echo "Running frontend tests..."
  cd src/frontend
  npm test -- --run
fi