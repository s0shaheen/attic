# Attic Backend Development Dockerfile
# Optimized for hot-reloading and fast iteration
#
# Usage:
#   docker build -f .docker/backend/Dockerfile.dev -t attic-backend-dev .
#   docker run -v ./src/backend:/app -p 8000:8000 attic-backend-dev

FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
# Copy only pyproject.toml first for better layer caching
COPY src/backend/pyproject.toml .

# Install dependencies (including dev dependencies for development)
RUN pip install --no-cache-dir -e ".[dev]"

# Install additional development tools
RUN pip install --no-cache-dir \
    watchfiles \
    python-dotenv

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run uvicorn with hot-reload
# --reload-dir ensures only app changes trigger reload (not test files, etc.)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "app"]
