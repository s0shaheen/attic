{
  "permissions": {
    "allow": [
      "Bash(pytest*)",
      "Bash(ruff*)",
      "Bash(npm test*)",
      "Bash(npm run*)",
      "Bash(alembic*)",
      "Bash(supabase*)",
      "Bash(sam local*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git merge*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git fetch*)",
      "Bash(git rebase*)",
      "Bash(pip install*)",
      "Bash(pip *)",
      "Bash(npm install*)",
      "Bash(mkdir*)",
      "Bash(touch*)",
      "Bash(cat*)",
      "Bash(ls*)",
      "Bash(cd*)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(which*)",
      "Bash(python*)",
      "Bash(python3*)",
      "Bash(node*)",
      "Bash(npx*)",
      "Bash(uv *)",
      "Bash(gh *)",
      "Bash(gh pr checks*)",
      "Bash(gh run watch*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(jq *)",
      "Bash(curl *)",
      "Bash(kill *)",
      "Bash(ps *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(xargs *)"
    ],
    "deny": [
      "Bash(rm -rf /)*",
      "Bash(*--force*delete*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(sam deploy*prod*)",
      "Bash(sam deploy*--stack-name*prod*)",
      "Bash(gh repo delete*)",
      "Bash(gh pr merge*--admin*)",
      "Bash(aws*--profile prod*)",
      "Bash(aws*production*)",
      "Bash(DROP TABLE*)",
      "Bash(DROP DATABASE*)",
      "Bash(TRUNCATE*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/hooks/post-edit-lint.sh"
          }
        ]
      }
    ]
  }
}
