# Lambda Function Environment Variables
# These are set via SAM template parameters, not .env files
# This file documents the required variables for reference

# Database
DATABASE_URL=postgresql://postgres:postgres@host:5432/postgres
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SECRET_KEY=eyJ...

# Third-party APIs
APIFY_API_TOKEN=apify_api_...
OPENAI_API_KEY=sk-...

# AWS Resources (set automatically by SAM)
TEMP_BUCKET=attic-temp-media-dev

# Application
ENVIRONMENT=dev
