# Lambda Function Environment Variables
# These are set via SAM template parameters, not .env files
# This file documents the required variables for reference

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@host:5432/postgres
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Third-party APIs
APIFY_API_TOKEN=apify_api_...
OPENAI_API_KEY=sk-...

# AWS Resources (set automatically by SAM)
TEMP_BUCKET_NAME=attic-temp-media
UPLOAD_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/...

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
